{
  "name": "attest",
  "version": "0.1.0",
  "private": true,
  "description": "Attest — evidence-backed release readiness for mobile apps. Prove your mobile release matches its promises.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b --clean tsconfig.build.json",
    "test": "npm run build && node --test packages/cli/dist/test/*.test.js",
    "demo": "npm run build && node packages/cli/dist/examples/demo.js",
    "web:dev": "node apps/web/scripts/serve.mjs",
    "web:build": "node apps/web/scripts/build.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
